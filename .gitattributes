* text=auto

# Unity YAML: merge with UnityYAMLMerge where configured
*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.meta      text eol=lf
*.cs        text diff=csharp

# Binary
*.png binary
*.jpg binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
